# Configuración web de Firebase (pública por diseño; constitución v3.0.0).
# Copia este archivo a .env.local con los valores de la app web "vamosjuntos-web"
# (consola de Firebase → Configuración del proyecto → Tus apps). En el pipeline llegan
# como variables de repositorio de GitHub (vars.VITE_FIREBASE_*).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
